# global settings
{
	# ACME INWX DNS Provider
	acme_dns inwx {
		username "{$INWX_USERNAME}"
		password "{$INWX_PASSWORD}"
		#shared_secret "{$INWX_SHARED_SECRET}"
		#endpoint_url "{$INWX_ENDPOINT_URL}" # Standard is the Prod Instance
	}
	# Crowdsec Provider. Get the key from the console
	crowdsec {
		api_url "{$CROWDSEC_API_URL}"
		api_key "{$CROWDSEC_API_KEY}"
		#ticker_interval 15s
		#appsec_url "{$CROWDSEC_APPSEC_URL}"
		#disable_streaming
		#enable_hard_fails
	}
}

# Import per-site configs from `sites/` directory
import sites/*
