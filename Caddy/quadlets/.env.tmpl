# Caddy environment (secrets) — copy to /etc/caddy/.env on the host.
# Do NOT commit the filled-in copy.
# Used by Caddyfile placeholders {$...} via podman --env-file.

# INWX DNS provider (ACME DNS-01 challenge)
INWX_USERNAME=changeme
INWX_PASSWORD=changeme

# CrowdSec bouncer key (generate on the host: `cscli bouncers add caddy`)
# The agent runs on the host; its LAPI listens on 0.0.0.0:8080 (restricted
# by UFW to the caddynet bridge 172.19.0.0/16). From inside the bridge
# network, the podman host is the gateway IP 172.19.0.1.
CROWDSEC_API_URL=http://172.19.0.1:8080/
CROWDSEC_API_KEY=changeme
