# .env.tmpl — copy to .env and fill in secrets
# NOTE: do NOT commit .env with secrets. Use this template as a starting point.

# INWX DNS provider (used for ACME DNS challenges)
INWX_USERNAME=
INWX_PASSWORD=
#INWX_SHARED_SECRET=
#INWX_ENDPOINT_URL= # optional, default: production

# CrowdSec config
CROWDSEC_API_URL=
CROWDSEC_API_KEY=

# Optional admin contact used by Caddy's TLS provider
#CADDY_ADMIN_EMAIL=

# For local testing only — map your hosts (e.g. /etc/hosts)
# e.g. 127.0.0.1 hello.altmann.it whoami.altmann.it searx.altmann.it
